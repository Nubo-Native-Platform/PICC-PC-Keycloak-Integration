# ==============================================================================
# PICC-PC-Keycloak-Integration - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# Do NOT commit '.env' or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=standalone
SPRING_CLOUD_CONFIG_ENABLED=false

# ------------------------------------------------------------------------------
# 2. Keycloak IAM Server Configuration
# ------------------------------------------------------------------------------
# Base URL of the Keycloak server instance
KEYCLOAK_URL=http://localhost:8081

# Administrative realm used for service authentication
KEYCLOAK_MASTER_REALM=master

# OAuth2 Client ID configured for service authentication (with service-accounts enabled)
KEYCLOAK_CLIENT_ID=admin-cli

# Secret key for client credentials grant (leave empty if using public client or populate with confidential client secret)
KEYCLOAK_CLIENT_SECRET=

# OAuth2 Grant Types
KEYCLOAK_GRANT_TYPE_CLIENT_CREDENTIALS=client_credentials
KEYCLOAK_GRANT_TYPE_REFRESH_TOKEN=refresh_token

# ------------------------------------------------------------------------------
# 3. Spring Cloud Config Server (Optional)
# ------------------------------------------------------------------------------
# Set to true when deploying in a microservices mesh with Spring Cloud Config Server
# SPRING_CONFIG_IMPORT=optional:configserver:http://localhost:8888/
